{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "perfumes-arbol-fragancias.vercel.app"
        }
      ],
      "destination": "/arbol-fragancias/index.html"
    },
    {
      "source": "/qr",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}